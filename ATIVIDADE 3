DROP PROCEDURE IF EXISTS buscar_alunos_por_idade;
DELIMITER //
CREATE PROCEDURE buscar_alunos_por_idade(IN idade_minima INT)
BEGIN
    SELECT id, nome, idade 
    FROM alunos 
    WHERE idade >= idade_minima;
END //
DELIMITER ;

