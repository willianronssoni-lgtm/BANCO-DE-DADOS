DROP PROCEDURE IF EXISTS mostrar_situacao;
DROP FUNCTION IF EXISTS calcular_media;

DELIMITER //

CREATE FUNCTION calcular_media(n1 DECIMAL(4,2), n2 DECIMAL(4,2))
RETURNS DECIMAL(4,2)
DETERMINISTIC
BEGIN
    RETURN (n1 + n2) / 2;
END //

CREATE PROCEDURE mostrar_situacao(IN aluno_id INT)
BEGIN
    SELECT 
        nome,
        nota1,
        nota2,
        calcular_media(nota1, nota2) AS media,
        CASE 
            WHEN calcular_media(nota1, nota2) >= 6.0 THEN 'Aprovado'
            WHEN calcular_media(nota1, nota2) >= 4.0 THEN 'Recuperação'
            ELSE 'Reprovado'
        END AS situacao
    FROM alunos_boletim
    WHERE id = aluno_id;
END //

DELIMITER ;

CALL mostrar_situacao(1);
CALL mostrar_situacao(2);
