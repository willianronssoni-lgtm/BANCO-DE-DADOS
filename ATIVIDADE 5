CREATE TABLE IF NOT EXISTS alunos_boletim (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(50),
    nota1 DECIMAL(4,2),
    nota2 DECIMAL(4,2)
);

TRUNCATE TABLE alunos_boletim;
